# Rendered by dotfiles/git/git-setup.sh into
# git/dqna64-dotfiles.gitconfig (next to this template, but gitignored
# because the rendered file contains per-machine values).
# DO NOT EDIT THE RENDERED FILE — edit git/gitconfig.template and re-run
# git-setup.sh. Placeholder values come from git/git-identity.
#
# The rendered file is consumed via an [include] block in ~/.gitconfig:
#
#     [include]
#         path = ~/dotfiles_dqna64/git/dqna64-dotfiles.gitconfig
#
# (Use the actual path to your clone if you cloned to a different location.
# git-setup.sh prints the exact line based on $DOTFILES_DIR.)
#
# The script never modifies ~/.gitconfig itself, so any machine-local
# config (e.g. [maintenance], [trace2]) you keep there is preserved
# across re-runs.

[user]
    name = "{{PRIMARY_NAME}}"
    email = "{{PRIMARY_EMAIL}}"

[core]
    excludesfile = ~/.gitignore_global
    editor = vim

[push]
    default = simple

[pull]
    rebase = true

[init]
	defaultBranch = main

# Identity switching aliases
# $ git primary    # Switch repo's user.name/user.email to primary (work)
# $ git secondary  # Switch repo's user.name/user.email to secondary (personal)
# $ git whoami     # Show repo's current user.name/user.email
#
# SSH key selection is no longer managed via git aliases. Instead, ~/.ssh/config
# defines one Host alias per GitHub account, named github.com-<github-username>
# (rendered by git/git-setup.sh from ssh/config.template — usernames come from
# git-identity). Attach a repo to a specific account by setting its remote URL
# to use the alias hostname, e.g.
#   git remote set-url origin git@github.com-{{PRIMARY_GITHUB_USERNAME}}:<org>/<repo>.git
[alias]
    primary = !git config user.name "{{PRIMARY_NAME}}" && git config user.email "{{PRIMARY_EMAIL}}" && echo "Switched to primary identity: {{PRIMARY_EMAIL}}"
    secondary = !git config user.name "{{SECONDARY_NAME}}" && git config user.email "{{SECONDARY_EMAIL}}" && echo "Switched to secondary identity: {{SECONDARY_EMAIL}}"
    whoami = !git config user.name && git config user.email

