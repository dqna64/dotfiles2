# === Copy to ~/.config/git/git-identity and fill in your details

# Primary git identity, used as default when running git operations that
# depend on git identity
PRIMARY_NAME="Primary Name"
PRIMARY_EMAIL="primary@example.com"

# Secondary git identity, opt in for repos in certain paths
SECONDARY_NAME="Secondary Name"  
SECONDARY_EMAIL="secondary@example.com"

PRIMARY_ACC_SSH_PRIV_KEY="/path/to/ssh/private_key"
SECONDARY_ACC_SSH_PRIV_KEY="/path/to/ssh/private_key"

# Short label for each account's SSH Host alias. Used by git-setup.sh to
# render aliases named github.com-<alias>, so remote URLs like
# git@github.com-<alias>:org/repo.git pick the right SSH key (and thus
# authenticate as the right account). The value is just a label — it must be
# unique and free of '@'/spaces, but need not be your GitHub username (a
# nickname like work/personal is fine). No effect outside SSH config rendering.
PRIMARY_ACC_SSH_ALIAS="acc1"
SECONDARY_ACC_SSH_ALIAS="acc2"
