# Rendered by dotfiles/git/git-setup.sh into
# ssh/dqna64-dotfiles.conf (next to this template, but gitignored
# because the rendered file contains per-machine values).
# DO NOT EDIT THE RENDERED FILE — edit ssh/config.template and re-run
# git-setup.sh. Placeholder values come from git/git-identity.
#
# The rendered file is consumed via an Include directive in ~/.ssh/config:
#
#     Include ~/dotfiles_dqna64/ssh/dqna64-dotfiles.conf
#
# (Use the actual path to your clone if you cloned to a different location.
# git-setup.sh prints the exact line based on $DOTFILES_DIR.)
#
# The script never modifies ~/.ssh/config itself, so any hand-curated
# Host blocks you keep there are preserved across re-runs.
#
# Per-account GitHub Host aliases, one per GitHub username. Both aliases
# resolve to github.com but offer different keys, so multiple GitHub
# accounts can be used in parallel without juggling ssh-agent. To attach a
# repo to a specific account, set its remote URL to use the alias hostname:
#
#   git remote set-url origin git@github.com-{{PRIMARY_GITHUB_USERNAME}}:org/repo.git
#   git remote set-url origin git@github.com-{{SECONDARY_GITHUB_USERNAME}}:user/repo.git
#
# IdentitiesOnly yes stops ssh-agent from offering any other loaded key,
# which would otherwise authenticate as the wrong account.

Host github.com-{{PRIMARY_GITHUB_USERNAME}}
    HostName github.com
    User git
    IdentityFile {{PRIMARY_REMOTE_ACCOUNT_SSH_PRIVATE_KEY}}
    IdentitiesOnly yes

Host github.com-{{SECONDARY_GITHUB_USERNAME}}
    HostName github.com
    User git
    IdentityFile {{SECONDARY_REMOTE_ACCOUNT_SSH_PRIVATE_KEY}}
    IdentitiesOnly yes
