# === Machine identifier
# Selects the per-machine directories in every dotfiles repo: zsh/zshrc.d.<id>/
# and the <file>.<id> variants of single files (claude/settings.<id>.json, ...),
# with <id> lowercased. Any identifier works; current ones:
#   DVBX1 .. DVBX5  - work devboxes
#   MB_M1           - personal MacBook
#   MB_CNV          - work MacBook
# Leave unset to load only the machine-independent files.
DQNA64_MACHINE=

# === Set zsh theme
# Note: oh-my-zsh already uses a variable called ZSH_THEME. We use ZSH_THEME_MY which
# may affect the final value set for ZSH_THEME by the zsh theme setup in these
# dotfiles.
# Options:
# - p10k
# - starship
ZSH_THEME_MY="p10k"

# === 
ENABLE_P10K_INSTANT_PROMPT=false

# === Yabai window manager for macos
# Enable Yabai along with my custom yabai configs
ENABLE_YABAI_DQNA64=false # true or false

# === Verbosity for my dotfiles stdout
# Options:
# - 0: almost nothing
# - 1: important messages
# - 2: informative messages
export VERBOSITY_DQNA64=1

# === Extension dotfiles repos (overlays)
# Extra repos with the same layout as this one, loaded after it: bin/,
# zsh/zshrc.d, zsh/zshrc.d.<machine>, claude/{skills,output-styles,rules},
# claude/settings*.json, tmux/.tmux.conf, karabiner/karabiner.json,
# yabai/yabairc, install.d, git/ssh templates. One entry per line, in load order:
#   "<clone url>"           cloned by install.sh to $HOME/<repo name>
#   "<clone url>=<path>"    cloned to <path>
#   "<path>"                an existing local directory, nothing cloned
# Paths are absolute: write "$HOME/x", not "~/x" (a quoted ~ does not expand).
# Leave the list empty on machines that use only this repo. The URL form is
# per machine: use whatever authenticates here (HTTPS app, or an SSH alias).
DOTFILES_OVERLAYS=(
)

# === Path for agents to store and read plans
# CLAUDE.*.md files in these dotfiles may tell agents to reference this path
# as the place to read and write plans, one file per branch.
# Change it only if you keep plans somewhere else.
# Default: AGENT_PLANS="$HOME/.agent_dqna64/plans"

export AGENT_PLANS="$HOME/.agent_dqna64/plans"

# === Path for agent activity logs
# Where agent sessions record what they changed: one folder per project, one
# file per session. Written automatically by utils/agent-log/ hooks; read with
# the `agentlog` alias. This root gets a <project slug>/ folder per project;
# logs are never written inside a project. Change it only to move that root.
# Default: AGENT_LOGS="$HOME/.agent_dqna64/logs"

export AGENT_LOGS="$HOME/.agent_dqna64/logs"

# === Machine log
# Optional log of software installed outside these dotfiles (brew formulae,
# manual installs, toolchains, GUI app settings, OS permissions).
# Path to this machine's log, read by install.sh and by agents.

export MACHINE_LOG_FILE=

# === Openrouter

export OPENROUTER_API_KEY=

# To fully set up Claude Code to route to your Openrouter account, also configure
# Anthropic section...
# ... then in Claude Code run /login

# === Anthropic

# Set to "https://openrouter.ai/api/v1" if you want to route Anthropic API to Openrouter
export ANTHROPIC_BASE_URL=
# Set to "$OPENROUTER_API_KEY" if you want to route claude code to your Openrouter account
export ANTHROPIC_AUTH_TOKEN=
# If you want to route claude code to Openrouter, you MUST explicitly set this
# to empty ("")
export ANTHROPIC_API_KEY=




